{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    "no-unused-expressions": ["error", { "allowTernary": true, "allowShortCircuit": true }],
    "typescript/no-misused-spread": "off"
  }
}
