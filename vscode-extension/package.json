{
  "name": "step-learn-for-vscode",
  "displayName": "STEP Learn for VSCode",
  "description": "STEP Learn で配られたプログラムのファイルを、ボタン 1 つで VS Code に用意して開きます。先生が指定したアイテムでは、保存した内容を変更履歴として STEP Learn に記録します。コーディングエージェントのアイテムでは、使える期間のあいだ AI がファイルを読み書きしてプログラムを書きます。",
  "version": "0.4.0",
  "publisher": "mint1535",
  "private": true,
  "license": "UNLICENSED",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sist-step/step-learn"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "STEP Learn",
    "LMS",
    "授業"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stepLearn.openRootFolder",
        "title": "配布ファイルの保存先を開く",
        "category": "STEP Learn"
      },
      {
        "command": "stepLearn.forgetServers",
        "title": "ファイルを受け取ってよいサーバーの記録を消す",
        "category": "STEP Learn"
      },
      {
        "command": "stepLearn.agent.open",
        "title": "コーディングエージェントを開く",
        "category": "STEP Learn"
      },
      {
        "command": "stepLearn.agent.newChat",
        "title": "新しいチャット",
        "category": "STEP Learn",
        "icon": "$(add)"
      },
      {
        "command": "stepLearn.agent.disconnect",
        "title": "コーディングエージェントの接続を解除する",
        "category": "STEP Learn"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stepLearn",
          "title": "STEP Learn",
          "icon": "images/agent.svg",
          "when": "stepLearn.noSecondarySidebar"
        }
      ],
      "secondarySidebar": [
        {
          "id": "stepLearnSecondary",
          "title": "STEP Learn",
          "icon": "images/agent.svg",
          "when": "!stepLearn.noSecondarySidebar"
        }
      ]
    },
    "views": {
      "stepLearn": [
        {
          "type": "webview",
          "name": "コーディングエージェント",
          "id": "stepLearn.agent",
          "when": "stepLearn.agentAvailable && stepLearn.noSecondarySidebar"
        }
      ],
      "stepLearnSecondary": [
        {
          "type": "webview",
          "name": "コーディングエージェント",
          "id": "stepLearn.agentSecondary",
          "when": "stepLearn.agentAvailable && !stepLearn.noSecondarySidebar"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "stepLearn.agent.newChat",
          "when": "view == stepLearn.agent || view == stepLearn.agentSecondary",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "stepLearn.agent.newChat",
          "when": "stepLearn.agentAvailable"
        },
        {
          "command": "stepLearn.agent.open",
          "when": "stepLearn.agentAvailable"
        }
      ]
    },
    "configuration": {
      "title": "STEP Learn",
      "properties": {
        "stepLearn.folder": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "配布されたファイルを用意するフォルダー。空のときは「ドキュメント/STEP Learn」に、コースとアイテムの名前のフォルダーを作ります。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies --skip-license",
    "publish": "npm run build && vsce publish --no-dependencies --skip-license",
    "lint": "oxlint --type-aware"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.93.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^5.6.0"
  }
}
