# STEP Learn の設定
#
# .env という名前でコピーして使う（cp .env.example .env）。
# npm run dev / npm start はリポジトリ直下の .env を読み、Docker Compose は compose.yaml の横の .env をアプリのコンテナに渡す。
# 開発（npm run dev）では何も設定しなくても動く。「必須」は、本番でリバースプロキシの後ろで動かすときに設定するもの。
# 「オプション」は、行頭の # を外して値を書くと有効になる。使わないものはコメントのままにする（空の値を書くと既定値にならないものがある）。
# 値に $ を含むときは '...' で囲む（Docker Compose は、囲まない値とダブルクォートの中の $ を変数として展開する）。
# 設定しないとどうなるかは docs/production.md の「環境変数」を参照。読み込んでいるのは src/lib/config.ts。

# ============================================================ 必須（本番）

# 公開 URL（例 https://lms.example.com）。末尾に / を付けない。
# 画面共有・共同編集の接続元の確認と、メールや Microsoft ログインの戻り先の URL に使う
APP_ORIGIN=

# リバースプロキシの後ろでは 1。付けないと、全員がプロキシの IP としてまとめてレート制限される
TRUST_PROXY=

# ============================================================ オプション

# ---------------------------------------------------------------- セッション

# セッション Cookie の署名鍵（32 文字以上。openssl rand -base64 32 などで作る）。
# 設定しなければ data/session-secret を作って使う。変えると全員がログアウトされ、保存中の AI のチャットも消える
# SESSION_SECRET=

# ---------------------------------------------------------------- メール

# 確認メールとパスワード再設定のメールを送る SMTP サーバー。SMTP_HOST がなければメールを送らず、本文をサーバーのログに出す。
# SMTP_HOST を設定するなら MAIL_FROM と APP_ORIGIN も必須。SMTP_PORT が 465 なら最初から TLS でつなぐ（既定は 587）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@example.com

# ---------------------------------------------------------------- AI

# Anthropic の API キー。AI エージェントとコーディング問題の採点で Claude を使う
# CLAUDE_API_KEY=

# OpenRouter の API キー。関係ない依頼の判定・STEP Docs の検索・予備のモデルと、npm run docs:index で使う
# OPENROUTER_API_KEY=

# AI エージェントを使えるメールアドレスのドメイン（@ より後ろが完全に一致するもの）。既定は sist.ac.jp
# AI_EMAIL_DOMAIN=sist.ac.jp

# ---------------------------------------------------------------- Microsoft アカウントでのログイン（通常モードだけ。docs/microsoft-login.md）

# MICROSOFT_CLIENT_ID を設定するなら MICROSOFT_CLIENT_SECRET も必須
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# テナント ID か common / organizations / consumers。既定は common
# MICROSOFT_TENANT=common

# ---------------------------------------------------------------- Moodle モード（moodle/README.md）

# MOODLE_URL を設定すると Moodle モードで動く。設定するなら MOODLE_EXCHANGE_TOKEN も必須
# MOODLE_URL=https://moodle.example.com
# MOODLE_EXCHANGE_TOKEN=

# Moodle のプラグインと共有する鍵（32 文字以上）。ログアウトの連動とコースの変更の通知に使う。
# なければ通知を受け取らず、STEP Learn からログアウトすると Moodle が確認の画面を出す
# MOODLE_BACKCHANNEL_SECRET=

# 完全移行の CLI（npm run moodle:migrate）が読む Moodle の URL と、すべてのコースを見られるアカウントのトークン。サーバーは使わない
# MOODLE_MIGRATE_URL=https://moodle.example.com
# MOODLE_MIGRATE_TOKEN=

# ---------------------------------------------------------------- Docker を使わずに動かすとき（Docker Compose では compose.yaml が決めるので書かない）

# 待ち受けポート。既定は 3000
# PORT=3000

# Python を実行する sandbox（sandbox/README.md）と、Web の提出を開く browser（browser/README.md）の接続先。
# unix:/ で始まるソケットの絶対パスか http://ホスト:ポート。なければ Python を選べず、Web の提出はコードだけで判定する
# SANDBOX_URL=http://127.0.0.1:8091
# BROWSER_URL=http://127.0.0.1:8092

# ---------------------------------------------------------------- Docker Compose の設定（compose.yaml が読む。アプリは読まない）

# データのボリュームの名前（<この値>_data）。既定は compose.yaml の name の step-learn。変えると空のボリュームで起動する
# COMPOSE_PROJECT_NAME=step-learn

# ホスト側で公開するポートとアドレス（docs/docker.md）
# HOST_PORT=3000
# HOST_BIND=127.0.0.1

# メモリの上限（docs/docker.md の「小さな VPS で動かす」）。APP_HEAP_MB は APP_MEM_LIMIT より十分小さくする
# APP_MEM_LIMIT=512m
# APP_HEAP_MB=320
# SANDBOX_MEM_LIMIT=512m
# BROWSER_MEM_LIMIT=1g
# BROWSER_SLOTS=2

# sandbox と browser を動かすランタイム。gVisor を入れたサーバーなら runsc（sandbox/README.md）
# SANDBOX_RUNTIME=runc

# STEP Docs の索引を置くディレクトリ（docs/ai-docs.md）。既定は ./ai-docs
# AI_DOCS_HOST_DIR=./ai-docs

# GHCR から pull するイメージ（APP_IMAGE / SANDBOX_IMAGE / BROWSER_IMAGE）は、デプロイのたびに変わるので、ここではなくシェルで export する
