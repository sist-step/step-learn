# サーバーのポート
PORT=3000

# SQLite と（ローカル保存時の）教材ファイルの置き場所
DATA_DIR=./data
# DATABASE_PATH=./data/step-learn.db

# 公開 URL。リバースプロキシ（nginx / Caddy など）の後ろで動かす場合は必須（CSRF 検証に使う）
# APP_ORIGIN=https://lms.example.com

# リバースプロキシの後ろで動かす場合は 1 にする（X-Forwarded-For の IP をレート制限に使う）
# TRUST_PROXY=1

# セッション Cookie の署名鍵（32 文字以上）。未設定なら DATA_DIR/session-secret を自動生成して使う
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# 教材ファイルを Cloudflare R2 に保存する場合（4 つすべて設定すると R2 に切り替わる）
# R2 ダッシュボード →「R2 API トークンを管理」でオブジェクトの読み書き権限のトークンを発行する
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=step-learn-files

# 確認メールの送信に使う SMTP サーバー。未設定ならメールは送らずサーバーのログに出力する
# SMTP_HOST を設定する場合は MAIL_FROM と APP_ORIGIN も必須（ポート 465 なら暗黙の TLS、それ以外は STARTTLS）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="StepLearn <no-reply@example.com>"
