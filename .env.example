# サーバーのポート
PORT=3000

# SQLite と（ローカル保存時の）教材ファイルの置き場所
DATA_DIR=./data
# DATABASE_PATH=./data/step-learn.db

# 公開 URL。リバースプロキシ（nginx / Caddy など）の後ろで動かす場合は必須（CSRF 検証に使う）
# APP_ORIGIN=https://lms.example.com

# 教材ファイルを Cloudflare R2 に保存する場合（4 つすべて設定すると R2 に切り替わる）
# R2 ダッシュボード →「R2 API トークンを管理」でオブジェクトの読み書き権限のトークンを発行する
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=step-learn-files
